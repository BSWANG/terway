From c3579cff1eb5fd3a83b3cad0e2198b92267f1ec9 Mon Sep 17 00:00:00 2001
From: "bingshen.wbs" <bingshen.wbs@alibaba-inc.com>
Date: Fri, 6 Nov 2026 16:55:32 +0800
Subject: [PATCH] fix: recover expired and throttled watches

Upstream-commit: 07163f8a4b8ab851706d95bd7ad3d6bc7ebfd031
---
 .../backend/watchersyncer/reflector_ports.go  | 54 +++++++++++++++++++
 .../lib/backend/watchersyncer/watchercache.go | 20 +++----
 2 files changed, 65 insertions(+), 9 deletions(-)
 create mode 100644 libcalico-go/lib/backend/watchersyncer/reflector_ports.go

diff --git a/libcalico-go/lib/backend/watchersyncer/reflector_ports.go b/libcalico-go/lib/backend/watchersyncer/reflector_ports.go
new file mode 100644
index 0000000..85f6909
--- /dev/null
+++ b/libcalico-go/lib/backend/watchersyncer/reflector_ports.go
@@ -0,0 +1,54 @@
+// Extracted from on Kubernetes reflector.go, Copyright 2014 The Kubernetes Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
