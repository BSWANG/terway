+			rs.clientWatchResponse(r1, genError)
+		}
+		rs.ExpectStatusUnchanged()
+		rs.clientListResponse(r1, emptyList)
+		rs.ExpectStatusUnchanged()
+		rs.clientWatchResponse(r1, nil)
+
